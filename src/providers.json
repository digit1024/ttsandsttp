{
  "version": "1.0.0",
  "source": "LunaAI/mobile_app lib/voice/voice_catalog.dart + mbdictate lib/voice/models.dart",
  "providers": {
    "groq": {
      "label": "Groq",
      "kind": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "env": "GROQ_API_KEY",
      "capabilities": {
        "stt": "openai_transcription",
        "tts": "openai_speech"
      }
    },
    "openrouter": {
      "label": "OpenRouter",
      "kind": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "env": "OPENROUTER_API_KEY",
      "capabilities": {
        "stt": "openai_transcription",
        "tts": "openai_speech"
      }
    },
    "dashscope": {
      "label": "Qwen / DashScope",
      "kind": "dashscope",
      "env": "DASHSCOPE_API_KEY",
      "capabilities": {
        "stt": "dashscope_asr",
        "tts": "dashscope_tts"
      }
    },
    "custom_openai": {
      "label": "Custom (OpenAI-compatible)",
      "kind": "openai",
      "is_custom": true,
      "capabilities": {
        "stt": "openai_transcription",
        "tts": "openai_speech"
      }
    },
    "custom_dashscope": {
      "label": "Custom (DashScope-compatible)",
      "kind": "dashscope",
      "is_custom": true,
      "capabilities": {
        "stt": "dashscope_asr",
        "tts": "dashscope_tts"
      }
    }
  },
