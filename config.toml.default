[stt]
# Whisper model to use for Speech-to-Text
# Options: 
#   - "sherpa-onnx-whisper-tiny" (recommended, multilingual, 75MB)
#   - "sherpa-onnx-whisper-tiny.en" (English only, 75MB)
#   - "sherpa-onnx-whisper-base" (multilingual, 150MB)
#   - "sherpa-onnx-whisper-base.en" (English only, 150MB)
#   - "sherpa-onnx-whisper-small" (multilingual, 500MB)
#   - "sherpa-onnx-whisper-medium" (multilingual, 1.5GB)
#   - "sherpa-onnx-whisper-large-v3" (multilingual, 3GB)
model_id = "sherpa-onnx-whisper-tiny"
