# TTSandSTTP Configuration File
# This file will be copied to ~/.config/ttsandsttp/config.toml on first run
# Uncomment languages you want to enable

[tts]
# Default TTS language (used when language is not specified)
default = "en"

# English (US) - Default enabled
[tts.en]
enabled = true
# Available models:
#   - "vits-piper-en_US-amy-low" (voice: amy, quality: low, 64MB) - DEFAULT
#   - "vits-piper-en_US-libritts_r-medium" (voice: libritts_r, quality: medium, 128MB)
#   - "vits-piper-en_US-glados" (voice: glados, quality: medium, 128MB)
#   - "vits-piper-en_US-lessac-medium" (voice: lessac, quality: medium, 128MB)
#   - "vits-piper-en_US-libritts-high" (voice: libritts, quality: high, 256MB)
model_id = "vits-piper-en_US-amy-low"

# Spanish (Spain) - Disabled by default
# [tts.es]
